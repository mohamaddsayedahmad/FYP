# =============================================================================
# AI Face Attendance System — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control (add it to .gitignore).
# =============================================================================

# ---- Database ---------------------------------------------------------------
# Path to the SQLite database file. Defaults to attendance.db next to the source.
ATTENDANCE_DB_PATH=./attendance.db

# ---- Encryption -------------------------------------------------------------
# Fernet symmetric key for biometric data encryption.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If this key is lost, all encrypted face encodings become unreadable.
# Store it securely (e.g., in a secrets manager, not in the repository).
ATTENDANCE_FERNET_KEY=your-fernet-key-here

# ---- JWT Authentication -----------------------------------------------------
# Secret for signing JWT access tokens. Must be at least 32 random bytes.
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ATTENDANCE_JWT_SECRET=your-jwt-secret-here

# JWT token expiry in minutes (default: 60)
ATTENDANCE_TOKEN_EXPIRE_MINUTES=60

# ---- SMTP Email (optional) --------------------------------------------------
# If not set, absence notifications are logged but not sent.
ATTENDANCE_SMTP_HOST=smtp.gmail.com
ATTENDANCE_SMTP_PORT=587
ATTENDANCE_SMTP_USER=your-email@gmail.com
ATTENDANCE_SMTP_PASS=your-app-password
ATTENDANCE_EMAIL_FROM=your-email@gmail.com
# Set to "true" to use SMTP_SSL (port 465). Leave unset for STARTTLS (port 587).
ATTENDANCE_SMTP_USE_SSL=false

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for the FastAPI server.
ATTENDANCE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8501

# ---- API Server -------------------------------------------------------------
# Used by uvicorn when starting the FastAPI server.
API_HOST=0.0.0.0
API_PORT=8000

# ---- Legacy Flask API (app.py) ----------------------------------------------
# Used only if running the old Flask server (kept for backward compatibility).
FLASK_PORT=5000
